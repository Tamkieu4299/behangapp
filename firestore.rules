rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authed() {
      return request.auth != null;
    }

    function isMember(jid) {
      return authed()
        && request.auth.uid in get(/databases/$(database)/documents/journeys/$(jid)).data.memberIds;
    }

    function isOwner(jid) {
      return authed()
        && get(/databases/$(database)/documents/journeys/$(jid)).data.createdBy == request.auth.uid;
    }

    // Users manage their own profile document.
    match /users/{uid} {
      allow read, write: if authed() && request.auth.uid == uid;
    }

    // Invite codes must be readable by anyone signed in so they can join.
    match /invites/{code} {
      allow read, write: if authed();
    }

    match /journeys/{jid} {
      // Readable by signed-in users: joining via a code requires reading the
      // journey first. Document ids are unguessable (Firestore auto-IDs), and
      // writes are still restricted to members.
      allow read: if authed();

      allow create: if authed()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds[0] == request.auth.uid;

      // Members may update; also allows a user to add themselves via arrayUnion
      // during the join-with-code batch.
      allow update: if isMember(jid)
        || request.auth.uid in request.resource.data.memberIds;

      allow delete: if isOwner(jid);

      match /members/{uid} {
        allow read: if isMember(jid);
        // The members-doc write is validated against the journey's memberIds
        // *after* the batch applies (getAfter), so the owner can be seeded in
        // the same atomic batch that creates the journey, and a joiner's own
        // member doc can be created while their uid is being added to the
        // journey's memberIds array in that same batch.
        allow write: if authed()
          && request.auth.uid in getAfter(/databases/$(database)/documents/journeys/$(jid)).data.memberIds;
      }

      match /records/{recordId} {
        allow read: if isMember(jid);
        allow write: if isMember(jid);
      }

      match /milestones/{milestoneId} {
        allow read: if isMember(jid);
        allow write: if isMember(jid);
      }

      match /stickers/{day} {
        allow read: if isMember(jid);
        allow write: if isMember(jid);
      }

      match /recap/{sessionId} {
        allow read: if isMember(jid);
        allow write: if isMember(jid);
      }
    }
  }
}